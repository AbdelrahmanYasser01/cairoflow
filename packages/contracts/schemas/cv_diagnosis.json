      "minLength": 1,
      "title": "Statement",
      "type": "string"
     },
     "status": {
      "minLength": 1,
      "title": "Status",
      "type": "string"
     },
     "unit": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Unit"
     },
     "value": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Value"
     }
    },
    "required": [
     "evidence_id",
     "statement",
     "evidence_kind",
     "status"
    ],
    "title": "CvEvidenceItem",
    "type": "object"
   },
   "CvHypothesis": {
    "additionalProperties": false,
