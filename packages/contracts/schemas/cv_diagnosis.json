{
 "CvDiagnosis": {
  "$defs": {
   "CvHypothesis": {
    "additionalProperties": false,
    "properties": {
     "confidence": {
      "enum": [
       "low",
       "medium",
       "high"
      ],
      "title": "Confidence",
      "type": "string"
     },
     "contradicting_evidence_ids": {
      "items": {
       "type": "string"
      },
      "title": "Contradicting Evidence Ids",
      "type": "array"
     },
     "how_to_check": {
      "description": "what measurement would settle it",
      "minLength": 1,
      "title": "How To Check",
      "type": "string"
     },
     "hypothesis_id": {
      "minLength": 1,
      "title": "Hypothesis Id",
      "type": "string"
     },
     "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
     },
     "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
     },
     "supporting_evidence_ids": {
      "items": {
       "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
     }
    },
    "required": [
     "hypothesis_id",
     "statement",
     "supporting_evidence_ids",
     "contradicting_evidence_ids",
     "confidence",
     "how_to_check"
    ],
    "title": "CvHypothesis",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "hypotheses": {
    "items": {
     "$ref": "#/$defs/CvHypothesis"
    },
    "title": "Hypotheses",
    "type": "array"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "title": "Limitations",
    "type": "array"
   },
   "schema_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Schema Version",
    "type": "string"
   },
   "summary": {
    "minLength": 1,
    "title": "Summary",
    "type": "string"
   }
  },
  "required": [
   "summary",
   "hypotheses",
   "limitations"
  ],
  "title": "CvDiagnosis",
  "type": "object"
 },
 "CvDiagnosisRecord": {
  "$defs": {
   "CvDiagnosis": {
    "additionalProperties": false,
    "properties": {
     "hypotheses": {
      "items": {
       "$ref": "#/$defs/CvHypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
     },
     "limitations": {
      "items": {
       "type": "string"
      },
      "title": "Limitations",
      "type": "array"
     },
     "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
     },
     "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
     }
    },
    "required": [
     "summary",
     "hypotheses",
     "limitations"
    ],
    "title": "CvDiagnosis",
    "type": "object"
   },
   "CvDiagnosisReplicate": {
    "additionalProperties": false,
    "description": "One independent reply, with what code found wrong with it.",
    "properties": {
     "citation_problems": {
      "default": [],
      "items": {
       "type": "string"
      },
      "title": "Citation Problems",
      "type": "array"
     },
     "cost_usd": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Cost Usd"
     },
     "diagnosis": {
      "anyOf": [
       {
        "$ref": "#/$defs/CvDiagnosis"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "failure": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Failure"
     },
     "from_cache": {
      "title": "From Cache",
      "type": "boolean"
     },
     "replicate": {
      "minimum": 1,
      "title": "Replicate",
      "type": "integer"
     },
     "request_key": {
      "title": "Request Key",
      "type": "string"
     },
     "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
     },
     "status": {
      "enum": [
       "ok",
       "failed"
      ],
      "title": "Status",
      "type": "string"
     },
     "unsupported_numbers": {
      "default": [],
      "items": {
       "type": "string"
      },
      "title": "Unsupported Numbers",
      "type": "array"
     }
    },
    "required": [
     "replicate",
     "status",
     "request_key",
     "from_cache"
    ],
    "title": "CvDiagnosisReplicate",
    "type": "object"
   },
   "CvEvidenceItem": {
    "additionalProperties": false,
    "description": "One fact the model was given, copied from the analysis record by code.",
    "properties": {
     "evidence_id": {
      "minLength": 1,
      "title": "Evidence Id",
      "type": "string"
     },
     "evidence_kind": {
      "enum": [
       "observed",
       "approximated",
       "assumed",
       "model_generated",
