    ],
    "title": "CvHypothesis",
    "type": "object"
   },
   "Provenance": {
    "additionalProperties": false,
    "description": "Who or what produced a piece of evidence, from which inputs, with which settings.",
    "properties": {
     "cached": {
      "default": false,
      "description": "True when replayed from cache, not produced live",
      "title": "Cached",
      "type": "boolean"
     },
     "input_sha256": {
      "default": [],
      "items": {
       "type": "string"
      },
      "title": "Input Sha256",
      "type": "array"
     },
     "kind": {
      "enum": [
       "observed",
       "approximated",
       "assumed",
       "model_generated",
       "simulated"
      ],
      "title": "Kind",
      "type": "string"
     },
     "parameters": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        }
       ]
      },
      "title": "Parameters",
      "type": "object"
     },
     "produced_at_utc": {
      "format": "date-time",
      "title": "Produced At Utc",
      "type": "string"
     },
     "produced_by": {
      "description": "module path or model id",
      "minLength": 1,
      "title": "Produced By",
      "type": "string"
     },
     "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
     },
     "software": {
      "additionalProperties": {
       "type": "string"
      },
      "description": "name -> version",
      "title": "Software",
      "type": "object"
     }
    },
    "required": [
     "kind",
     "produced_by",
     "produced_at_utc"
    ],
    "title": "Provenance",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "description": "Every reply to one request about one analysis.",
  "properties": {
   "analysis_id": {
    "minLength": 1,
    "title": "Analysis Id",
    "type": "string"
   },
   "analysis_record_sha256": {
    "title": "Analysis Record Sha256",
    "type": "string"
   },
   "created_at_utc": {
    "format": "date-time",
    "title": "Created At Utc",
    "type": "string"
   },
   "evidence": {
    "items": {
     "$ref": "#/$defs/CvEvidenceItem"
    },
    "title": "Evidence",
    "type": "array"
   },
   "label": {
    "minLength": 1,
    "title": "Label",
    "type": "string"
   },
   "model": {
    "minLength": 1,
    "title": "Model",
    "type": "string"
   },
   "prompt_version": {
    "minLength": 1,
    "title": "Prompt Version",
    "type": "string"
   },
   "provenance": {
    "$ref": "#/$defs/Provenance"
   },
   "replicates": {
    "items": {
     "$ref": "#/$defs/CvDiagnosisReplicate"
    },
    "title": "Replicates",
    "type": "array"
   },
   "schema_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Schema Version",
    "type": "string"
   }
  },
  "required": [
   "label",
   "analysis_id",
   "analysis_record_sha256",
   "model",
   "prompt_version",
   "created_at_utc",
   "evidence",
   "replicates",
   "provenance"
  ],
  "title": "CvDiagnosisRecord",
  "type": "object"
