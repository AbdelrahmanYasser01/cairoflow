      "title": "How To Check",
      "type": "string"
     },
     "hypothesis_id": {
      "minLength": 1,
      "title": "Hypothesis Id",
      "type": "string"
     },
     "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
     },
     "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
     },
     "supporting_evidence_ids": {
      "items": {
       "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
