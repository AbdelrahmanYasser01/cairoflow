{
 "AnnotatedFrame": {
  "additionalProperties": false,
  "description": "Which frame was sent: the pinned overlay it was cut from, and the image bytes.",
  "properties": {
   "frame_index": {
    "description": "0-based frame of the overlay video",
    "minimum": 0,
    "title": "Frame Index",
    "type": "integer"
   },
   "height_px": {
    "exclusiveMinimum": 0,
    "title": "Height Px",
    "type": "integer"
   },
   "image_path": {
    "description": "repository-relative path of the JPEG sent",
    "title": "Image Path",
    "type": "string"
   },
   "image_sha256": {
    "title": "Image Sha256",
    "type": "string"
   },
   "schema_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Schema Version",
    "type": "string"
   },
   "source_path": {
    "description": "repository-relative path of the overlay video",
    "title": "Source Path",
    "type": "string"
   },
   "source_sha256": {
    "title": "Source Sha256",
    "type": "string"
   },
   "time_s": {
    "description": "seconds from the start of the overlay video",
    "minimum": 0,
    "title": "Time S",
    "type": "number"
   },
   "width_px": {
    "exclusiveMinimum": 0,
    "title": "Width Px",
    "type": "integer"
   }
  },
  "required": [
   "source_path",
   "source_sha256",
   "frame_index",
   "time_s",
   "image_path",
   "image_sha256",
   "width_px",
   "height_px"
  ],
  "title": "AnnotatedFrame",
  "type": "object"
 },
 "AnnotatedObject": {
  "additionalProperties": false,
  "description": "One road user the model says it sees, where, and whether the SAM overlay boxes it.",
  "properties": {
   "category": {
    "enum": [
     "car",
     "bus",
     "truck",
     "motorcycle",
     "bicycle",
     "pedestrian",
     "other"
    ],
    "title": "Category",
    "type": "string"
   },
   "note": {
    "title": "Note",
    "type": "string"
   },
   "overlay_box": {
    "description": "whether a SAM overlay box is drawn on it, as the model reads the frame",
    "enum": [
     "boxed",
     "not_boxed",
     "unclear"
    ],
    "title": "Overlay Box",
    "type": "string"
   },
   "region": {
    "description": "ninth of the image the object is in, image coordinates",
    "enum": [
     "top_left",
     "top",
     "top_right",
     "left",
     "center",
     "right",
     "bottom_left",
     "bottom",
     "bottom_right"
    ],
    "title": "Region",
    "type": "string"
   },
   "schema_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Schema Version",
    "type": "string"
   }
  },
  "required": [
   "category",
   "region",
   "overlay_box",
   "note"
  ],
  "title": "AnnotatedObject",
  "type": "object"
 },
 "EvidenceRecurrence": {
