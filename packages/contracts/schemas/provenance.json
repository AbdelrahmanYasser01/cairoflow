{
 "ChainBreak": {
  "additionalProperties": false,
  "properties": {
   "at": {
    "description": "the record whose derivation could not be followed",
    "title": "At",
    "type": "string"
   },
   "code": {
    "enum": [
     "missing_link",
     "unknown_node",
     "wrong_entity_type",
     "hash_mismatch",
     "wrong_stage",
     "cycle"
    ],
    "title": "Code",
    "type": "string"
   },
   "missing": {
    "description": "the relationship, e.g. 'problem_statement <- world_entity'",
    "title": "Missing",
    "type": "string"
   },
   "reason": {
    "minLength": 1,
    "title": "Reason",
    "type": "string"
   },
   "schema_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Schema Version",
    "type": "string"
   }
  },
  "required": [
   "code",
   "at",
   "missing",
   "reason"
  ],
  "title": "ChainBreak",
  "type": "object"
 },
 "LinkEnd": {
  "additionalProperties": false,
  "description": "A record a link names, and the hash the stating record gives for it (None: none given).",
  "properties": {
   "record_id": {
    "pattern": "^\\S+$",
    "title": "Record Id",
    "type": "string"
   },
   "record_type": {
    "enum": [
     "DatasetFile",
     "SourceClip",
     "SamResponse",
     "TrackFile",
     "TrafficWorldModel",
     "WorldEntity",
     "ProblemStatement",
     "InterventionProposal",
     "ExperimentManifest",
     "DecisionReport"
    ],
    "title": "Record Type",
    "type": "string"
   },
   "schema_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Schema Version",
    "type": "string"
   },
   "stated_sha256": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Stated Sha256"
   }
  },
  "required": [
   "record_type",
   "record_id"
  ],
  "title": "LinkEnd",
  "type": "object"
 },
 "NodeRef": {
  "additionalProperties": false,
  "description": "One existing record, by its existing id and content hash; never a copy of it.",
  "properties": {
   "category": {
    "enum": [
     "camera_derived",
     "dataset_derived",
     "world_model",
     "simulated",
     "ai_generated"
    ],
    "title": "Category",
    "type": "string"
   },
   "content_sha256": {
    "title": "Content Sha256",
    "type": "string"
   },
   "evidence_kind": {
    "description": "as the record states it, not re-judged",
    "enum": [
     "observed",
     "approximated",
     "assumed",
     "model_generated",
     "simulated"
    ],
    "title": "Evidence Kind",
    "type": "string"
   },
   "hash_basis": {
    "enum": [
     "file_bytes",
     "model_dump_json",
     "canonical_json",
     "proposal_sha256",
     "request_key"
    ],
    "title": "Hash Basis",
    "type": "string"
   },
   "model_output": {
    "default": false,
    "description": "the record is a model's output (SAM, Muse)",
    "title": "Model Output",
    "type": "boolean"
   },
   "record_id": {
    "description": "the id the record already has",
    "pattern": "^\\S+$",
    "title": "Record Id",
    "type": "string"
   },
   "record_type": {
    "enum": [
     "DatasetFile",
     "SourceClip",
     "SamResponse",
     "TrackFile",
     "TrafficWorldModel",
     "WorldEntity",
     "ProblemStatement",
     "InterventionProposal",
     "ExperimentManifest",
     "DecisionReport"
    ],
    "title": "Record Type",
    "type": "string"
   },
   "schema_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Schema Version",
    "type": "string"
   },
   "stage": {
    "enum": [
     "source_record",
     "observation",
     "world_entity",
     "problem_statement",
     "intervention",
     "experiment",
     "decision_report"
    ],
    "title": "Stage",
    "type": "string"
   }
  },
  "required": [
   "stage",
   "record_type",
   "record_id",
   "content_sha256",
   "hash_basis",
   "category",
   "evidence_kind"
  ],
  "title": "NodeRef",
  "type": "object"
 },
 "ProblemStatement": {
  "additionalProperties": false,
  "description": "A traffic problem named by a deterministic rule on WorldView entities; no number, no model\ntext. `statement` is written by the rule's code.",
  "properties": {
   "entity_ids": {
    "description": "sorted, unique",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "title": "Entity Ids",
    "type": "array"
   },
   "problem_id": {
    "pattern": "^[a-z0-9][a-z0-9_.-]*$",
    "title": "Problem Id",
    "type": "string"
   },
   "problem_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Problem Version",
    "type": "string"
   },
   "produced_by": {
    "const": "rule",
    "default": "rule",
    "title": "Produced By",
    "type": "string"
   },
   "rule_id": {
    "pattern": "^[a-z0-9][a-z0-9_.-]*$",
    "title": "Rule Id",
    "type": "string"
   },
   "rule_version": {
    "minLength": 1,
    "title": "Rule Version",
    "type": "string"
   },
   "schema_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Schema Version",
    "type": "string"
   },
   "statement": {
    "minLength": 1,
    "title": "Statement",
    "type": "string"
   },
   "view_sha256": {
    "description": "the WorldView whose entities it names",
    "title": "View Sha256",
    "type": "string"
   },
   "world_model_sha256": {
    "description": "canonical: sha256 of model_dump_json()",
    "title": "World Model Sha256",
    "type": "string"
   }
  },
  "required": [
   "problem_id",
   "rule_id",
   "rule_version",
   "statement",
   "world_model_sha256",
   "view_sha256",
   "entity_ids"
  ],
  "title": "ProblemStatement",
  "type": "object"
 },
