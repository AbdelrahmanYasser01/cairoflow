   "flags",
   "supporting_kinds"
  ],
  "title": "HypothesisGrounding",
  "type": "object"
 },
 "InterventionProposal": {
  "$defs": {
   "PhaseChange": {
    "additionalProperties": false,
    "properties": {
     "green_s": {
      "title": "Green S",
      "type": "number"
     },
     "phase_name": {
      "minLength": 1,
      "title": "Phase Name",
      "type": "string"
     },
     "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
     }
    },
    "required": [
     "phase_name",
     "green_s"
    ],
    "title": "PhaseChange",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "addresses_hypothesis_ids": {
    "items": {
     "type": "string"
    },
    "title": "Addresses Hypothesis Ids",
    "type": "array"
   },
   "evidence_ids": {
    "items": {
     "type": "string"
    },
    "title": "Evidence Ids",
    "type": "array"
   },
   "expected_tradeoffs": {
    "description": "words only; no predicted metrics",
    "items": {
     "type": "string"
    },
    "title": "Expected Tradeoffs",
    "type": "array"
   },
   "intervention_id": {
    "pattern": "^I[1-9][0-9]?$",
    "title": "Intervention Id",
    "type": "string"
   },
   "phase_changes": {
    "items": {
     "$ref": "#/$defs/PhaseChange"
    },
    "title": "Phase Changes",
    "type": "array"
   },
   "preconditions": {
    "items": {
     "type": "string"
    },
    "title": "Preconditions",
    "type": "array"
   },
   "rationale": {
    "minLength": 1,
    "title": "Rationale",
    "type": "string"
   },
   "schema_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Schema Version",
    "type": "string"
   },
   "target_program": {
    "title": "Target Program",
    "type": "string"
   },
   "type": {
    "description": "checked against the allowlist later",
    "pattern": "^[a-z_]+$",
    "title": "Type",
    "type": "string"
   }
  },
  "required": [
   "intervention_id",
   "type",
   "target_program",
   "phase_changes",
   "rationale",
   "expected_tradeoffs",
   "preconditions",
   "addresses_hypothesis_ids",
   "evidence_ids"
  ],
  "title": "InterventionProposal",
  "type": "object"
 },
