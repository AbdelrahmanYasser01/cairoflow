     "missing_evidence": {
      "description": "every missing item the model named",
      "items": {
       "type": "string"
      },
      "title": "Missing Evidence",
      "type": "array"
     },
     "notes": {
      "items": {
       "type": "string"
      },
      "title": "Notes",
      "type": "array"
     },
