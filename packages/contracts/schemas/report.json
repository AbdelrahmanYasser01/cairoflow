{
 "BaselineAssessment": {
  "additionalProperties": false,
  "description": "How far observations support the simulated baseline: an engineering judgement, recorded\nwith the evidence it rests on. Only `validated` lets a selected candidate be recommended.",
  "properties": {
   "assessed_on": {
    "description": "ISO date; see the document named in `documented_in`",
    "title": "Assessed On",
    "type": "string"
   },
   "baseline_manifest_sha256": {
    "description": "the baseline this assessment is about",
    "title": "Baseline Manifest Sha256",
    "type": "string"
   },
   "documented_in": {
    "title": "Documented In",
    "type": "string"
   },
   "evidence": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "committed record path -> SHA-256",
    "title": "Evidence",
    "type": "object"
   },
   "findings": {
    "items": {
     "type": "string"
    },
    "title": "Findings",
    "type": "array"
   },
   "schema_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Schema Version",
    "type": "string"
   },
   "status": {
    "enum": [
     "validated",
     "partially_validated",
     "not_validated",
     "not_assessed"
    ],
    "title": "Status",
    "type": "string"
   },
   "summary": {
    "minLength": 1,
    "title": "Summary",
    "type": "string"
   }
  },
  "required": [
   "baseline_manifest_sha256",
   "status",
   "summary",
   "findings",
   "evidence",
   "assessed_on",
   "documented_in"
  ],
  "title": "BaselineAssessment",
  "type": "object"
 },
 "CandidateFinding": {
  "additionalProperties": false,
  "description": "One proposal: what the model said (text), what the validator and SUMO made of it.",
  "properties": {
   "addresses_hypothesis_ids": {
    "items": {
     "type": "string"
    },
    "title": "Addresses Hypothesis Ids",
    "type": "array"
   },
   "confirmed_improvements": {
    "default": [],
    "description": "metrics whose improvement survives Holm's correction",
    "items": {
     "type": "string"
    },
    "title": "Confirmed Improvements",
    "type": "array"
   },
   "expected_tradeoffs": {
    "description": "model_generated text",
    "items": {
     "type": "string"
    },
    "title": "Expected Tradeoffs",
    "type": "array"
   },
   "grounding_reasons": {
    "default": [],
    "description": "why the grounding gate kept it from planning, if it did",
    "items": {
     "type": "string"
    },
    "title": "Grounding Reasons",
    "type": "array"
   },
   "intervention_id": {
    "title": "Intervention Id",
    "type": "string"
   },
   "number_ids": {
    "items": {
     "type": "string"
    },
    "title": "Number Ids",
    "type": "array"
   },
   "rationale": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "model_generated text",
    "title": "Rationale"
   },
   "schema_version": {
    "const": "0.1.0",
    "default": "0.1.0",
    "title": "Schema Version",
    "type": "string"
   },
   "simulation_reasons": {
    "default": [],
    "description": "why it was not compared (unfinished vehicles, broken runs)",
    "items": {
     "type": "string"
    },
    "title": "Simulation Reasons",
    "type": "array"
   },
   "simulation_status": {
    "anyOf": [
     {
      "enum": [
       "not_simulated",
       "compared",
       "incomplete",
       "invalid_simulation"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "eligibility of its SUMO runs; None in older reports",
    "title": "Simulation Status"
   },
   "status": {
    "enum": [
     "accepted",
     "rejected"
    ],
    "title": "Status",
    "type": "string"
   },
   "unverified_assumptions": {
    "default": [],
    "description": "the proposal's preconditions: model-stated, never checked by code",
    "items": {
     "type": "string"
    },
    "title": "Unverified Assumptions",
    "type": "array"
   },
   "validator_reasons": {
    "items": {
     "type": "string"
    },
    "title": "Validator Reasons",
    "type": "array"
   },
   "verdicts": {
    "additionalProperties": {
     "enum": [
      "improves",
      "worsens",
      "inconclusive",
      "uninformative"
     ],
     "type": "string"
    },
    "title": "Verdicts",
    "type": "object"
   }
  },
  "required": [
   "intervention_id",
   "status",
   "validator_reasons",
   "rationale",
   "expected_tradeoffs",
   "addresses_hypothesis_ids",
   "verdicts",
   "number_ids"
  ],
  "title": "CandidateFinding",
  "type": "object"
 },
